# Copie este arquivo para ".env" e troque os valores. O arquivo .env NÃO vai para o GitHub.
# Senha do banco de dados (interna, ninguém digita)
DB_PASSWORD=troque-por-uma-senha-longa-do-banco
# Login do marketing no Arcom Play (usuário em minúsculas; senha com 8+ caracteres, forte)
ADMIN_USER=marketing
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Porta onde o site fica disponível no servidor
APP_PORT=8080
